{
  appId: "com.yourname.smart-slideshow",
  productName: "Smart Slideshow",
  win: {
    icon: "build/icon.ico",
    certificateFile: null,
    signingHashAlgorithms: null,
  },
  directories: {
    output: "dist",
  },
  files: ["dist-electron/**/*", "dist/**/*"],
  extraResources: [
    {
      from: "./electron/backend/backend.exe",
      to: "backend.exe",
    },
    {
      from: "./electron/backend/redis-server.exe",
      to: "redis-server.exe",
    },
    {
      from: "./.env",
      to: ".env",
    },
  ],
}
