{
  "name": "smart-slideshow",
  "productName": "Smart Slideshow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "wait-on http://localhost:5173 && electron .",
    "build": "tsc -b && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:app"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "30.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^9.0.10"
  },
  "extraResources": [
    {
      "from": "./electron/backend/backend.exe",
      "to": "backend.exe"
    }
  ]
}
